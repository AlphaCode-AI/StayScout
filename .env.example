# 공공데이터포털에서 받은 "디코딩" 인증키를 넣으세요
GOCAMPING_SERVICE_KEY=

# Google AI Studio에서 받은 Gemini API 키
GEMINI_API_KEY=
# 비워 두면 사용 가능한 Flash 모델을 자동으로 골라요
GEMINI_MODEL=

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키 (주소를 좌표로 바꿀 때 사용)
KAKAO_REST_API_KEY=

# (선택) 펜션 홈페이지·평점 찾기 — 화면에 보이는 상위 10곳만 조회해요
# Google Cloud > Places API (New) 키
GOOGLE_PLACES_API_KEY=
# 네이버 클라우드 API HUB > 지역 검색 Client ID / Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 하루 호출 한도. 무료 사용량 안에서 쓰려고 코드에서 막아요 (콘솔 할당량과 맞추기)
# 구글: 콘솔 하루 30회
GOOGLE_DAILY_LIMIT=30
# 네이버: 콘솔 하루 50회 · 월 1,000회
NAVER_DAILY_LIMIT=50
# 구글 사진: 상세 보기에서 사진 없는 펜션에만, 하루 장 수 (Place Details Photos 월 1,000건 무료)
GOOGLE_PHOTO_DAILY_LIMIT=30
# 카카오내비 길찾기(상위 10곳 실제 이동 시간): 같은 KAKAO_REST_API_KEY를 써요. 하루 무료 10,000건, 코드 한도 기본 3,000
KAKAO_ROUTE_DAILY_LIMIT=3000
